# Copy to .env and fill in the blanks. .env is gitignored.

# --- Server ---
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Extra origins allowed to call the auth endpoints, comma-separated.
# Used for tunnels, e.g. EXTRA_TRUSTED_ORIGINS=https://abc123.ngrok-free.app
EXTRA_TRUSTED_ORIGINS=

# --- Better Auth ---
# Generate with: bun x auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Dash (hosted dashboard) — powers the dash() plugin.
# Get one from https://dash.better-auth.com
BETTER_AUTH_API_KEY=

# --- SMS API PH (for phone verification & notifications) ---
SMS_API_KEY=

# --- Client IP / rate limiting ---
# Header your reverse proxy or CDN overwrites with the real client IP. Keep
# this to headers the edge controls; a header a client can set would let it
# choose its own rate-limit bucket. Defaults to x-forwarded-for.
#   Cloudflare: cf-connecting-ip
#   Vercel:     x-vercel-forwarded-for
#   nginx:      x-real-ip
AUTH_IP_ADDRESS_HEADERS=x-forwarded-for

# Only needed when AUTH_IP_ADDRESS_HEADERS can contain a comma-separated chain
# (for example an appending proxy or load balancer). Comma-separated proxy IPs
# or CIDRs; never include client ranges. Better Auth walks the chain right to
# left, skips these hops, and uses the first untrusted address as the client.
#   AUTH_TRUSTED_PROXIES=192.0.2.10,10.0.0.0/24
AUTH_TRUSTED_PROXIES=

# Better Auth enables its rate limiter by default only in production. Deployed
# environments must set NODE_ENV=production for that default to take effect.
# Leave it unset locally so the E2E suite can sign in repeatedly.
# NODE_ENV=production

# --- Neon PostgreSQL ---
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-morning-firefly-aom4sf7u-pooler.c-2.ap-southeast-1.aws.neon.tech/btp-karaokeDB?sslmode=verify-full&channel_binding=require
# Custom CA trust root, relative to this folder. Leave EMPTY for Neon: its
# certificate chains to the public CAs in the system trust store, and a
# non-empty value pins verification to that file alone (rejectUnauthorized),
# which Neon's cert does not satisfy. Set ./ca.pem only when DATABASE_URL
# points at Aiven, whose CA is not in the public store.
DB_CA_FILE=

# --- E2E / disposable DB seeding ---
# Password for the QA admin account seeded by `npm run seed:qa-admin`.
# Must match the value used by the Playwright admin setup (TEST_ADMIN_PASSWORD).
# TEST_ADMIN_PASSWORD=

# --- Redis (optional cache) ---
# When set, the catalog/closure caches use Redis instead of in-memory, so they
# stay shared across instances. Leave blank to use the in-process cache.
# REDIS_URL=redis://localhost:6379
REDIS_URL=
