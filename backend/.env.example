# Copy to .env and fill in the blanks. .env is gitignored.

# --- Server ---
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# --- Better Auth ---
# Generate with: bun x auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Aiven PostgreSQL (Free Tier) ---
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@btp-karaoke-btp-karaoke.k.aivencloud.com:19870/defaultdb?sslmode=require
# Path to the Aiven CA cert, relative to this folder. Empty string = skip cert verification.
DB_CA_FILE=./ca.pem

# --- Google OAuth (leave blank until you create the credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
