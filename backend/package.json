{
  "name": "backend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env --watch serve.ts",
    "start": "node --env-file=.env serve.ts",
    "db:generate": "drizzle-kit generate",
    "db:auth-migrate": "node --env-file=.env scripts/apply-better-auth-migrations.ts",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "seed": "node --env-file=.env scripts/seed.ts",
    "seed:e2e": "node --env-file=.env scripts/seed-e2e-user.ts",
    "promote-admin": "node --env-file=.env scripts/promote-admin.ts",
    "test": "node --test src/auth-settings.test.ts src/location.test.ts src/bookings/validation.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.20",
    "@hono/node-server": "2.1.5",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  }
}
